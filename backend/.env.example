# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SortAid

# Port the Express server listens on
PORT=8000

# Secret used to sign/verify JWTs — use a long random string in real deployments,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
